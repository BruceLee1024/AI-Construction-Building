{
  "name": "furniture-inside-slab",
  "description": "Place a sofa inside a room slab and confirm it remains valid.",
  "steps": [
    {
      "tool": "create_room",
      "args": {
        "origin": [0, 0],
        "width": 6,
        "depth": 5,
        "addDoor": false,
        "addWindows": true
      }
    },
    {
      "tool": "place_furniture",
      "args": {
        "type": "sofa",
        "position": [3, 0.05, 2.5],
        "rotation": 0
      }
    }
  ],
  "assertions": [
    { "type": "toolResult.success", "step": 0 },
    { "type": "toolResult.success", "step": 1 },
    { "type": "node.count", "nodeType": "item", "exact": 1 },
    { "type": "node.exists", "nodeType": "item", "where": { "asset.id": "sofa" } },
    { "type": "validation", "valid": true, "blocking": false, "warningCount": 0 }
  ]
}
