{
  "name": "china-zone-metadata-roomtype",
  "description": "Zone metadata roomType should drive china_residential room-specific checks even when the label is generic.",
  "validationArgs": { "codeProfile": "china_residential" },
  "steps": [
    {
      "tool": "create_room",
      "args": {
        "origin": [0, 0],
        "width": 2.2,
        "depth": 2.5,
        "addDoor": true,
        "addWindows": true
      }
    },
    {
      "tool": "create_zone",
      "args": {
        "name": "Room A",
        "roomType": "bedroom",
        "polygon": [[0.1, 0.1], [2.1, 0.1], [2.1, 2.4], [0.1, 2.4]]
      }
    }
  ],
  "assertions": [
    { "type": "node.exists", "nodeType": "zone", "where": { "metadata.roomType": "bedroom" } },
    { "type": "validation", "valid": false, "blocking": true, "codeProfile": "china_residential", "mustIncludeRuleIds": ["room.bedroom_min_area", "room.bedroom_min_width"] }
  ]
}
