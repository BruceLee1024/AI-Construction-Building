{
  "name": "china-negative-main-space-daylight",
  "description": "A main residential room without daylight should trigger room.main_space_daylight.",
  "validationArgs": { "codeProfile": "china_residential" },
  "steps": [
    {
      "tool": "create_room",
      "args": {
        "origin": [0, 0],
        "width": 4,
        "depth": 4,
        "addDoor": true,
        "addWindows": false
      }
    },
    {
      "tool": "create_zone",
      "args": {
        "name": "Living Room",
        "roomType": "living",
        "polygon": [[0.1, 0.1], [3.9, 0.1], [3.9, 3.9], [0.1, 3.9]]
      }
    }
  ],
  "assertions": [
    { "type": "validation", "valid": false, "blocking": true, "codeProfile": "china_residential", "mustIncludeRuleIds": ["room.main_space_daylight"] }
  ]
}
