{
  "name": "negative-door-clear-width",
  "description": "A too-narrow door must produce a stable door.clear_width rule warning.",
  "steps": [
    {
      "tool": "create_room",
      "args": {
        "origin": [0, 0],
        "width": 5,
        "depth": 4,
        "addDoor": false,
        "addWindows": true
      }
    },
    {
      "tool": "create_door",
      "args": {
        "wallIndex": 0,
        "position_t": 0.5,
        "width": 0.65
      }
    }
  ],
  "assertions": [
    { "type": "toolResult.success", "step": 0 },
    { "type": "toolResult.success", "step": 1 },
    { "type": "node.count", "nodeType": "door", "exact": 1 },
    { "type": "validation", "valid": false, "blocking": true, "blockingCount": { "min": 1 }, "ruleSummary": { "door.clear_width": 1 }, "mustIncludeRuleIds": ["door.clear_width"] }
  ]
}
