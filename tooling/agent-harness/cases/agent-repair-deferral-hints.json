{
  "name": "agent-repair-deferral-hints",
  "description": "Blocking validation produces repair hints and blocks post-layout tools with structured next actions.",
  "validationArgs": { "codeProfile": "china_residential" },
  "steps": [
    {
      "tool": "create_room",
      "args": { "origin": [0, 0], "width": 4, "depth": 4, "addDoor": true, "addWindows": false }
    },
    {
      "tool": "create_zone",
      "args": {
        "name": "客厅",
        "roomType": "living",
        "polygon": [[0.1, 0.1], [3.9, 0.1], [3.9, 3.9], [0.1, 3.9]]
      }
    }
  ],
  "assertions": [
    { "type": "validation", "valid": false, "blocking": true, "codeProfile": "china_residential", "mustIncludeRuleIds": ["room.main_space_daylight"] },
    { "type": "validation.repairHints", "mustIncludeRuleIds": ["room.main_space_daylight"], "mustIncludePreferredTools": ["add_window_to_wall"] },
    {
      "type": "agent.deferral",
      "toolName": "place_furniture",
      "userContent": "创建一个符合中国住宅规则的卧室并摆放家具",
      "lastValidation": {
        "valid": false,
        "blocking": true,
        "fixedCount": 0,
        "warningCount": 1,
        "blockingRuleIds": ["room.main_space_daylight"],
        "repairHints": [
          {
            "ruleId": "room.main_space_daylight",
            "nodeId": "zone_test",
            "preferredTools": ["add_window_to_wall", "auto_align_windows"],
            "suggestedAction": "Add an exterior window."
          }
        ],
        "issues": [
          {
            "severity": "warning",
            "type": "code",
            "ruleId": "room.main_space_daylight",
            "nodeId": "zone_test",
            "message": "Main space daylight is insufficient."
          }
        ]
      },
      "deferred": true,
      "phaseBlockedBy": "validation_repair",
      "mustIncludeAllowedTools": ["add_window_to_wall", "modify_node"],
      "mustIncludeRuleIds": ["room.main_space_daylight"]
    }
  ]
}
